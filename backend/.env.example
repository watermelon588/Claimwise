# Copy to backend/.env and fill in. Never commit .env.

# Primary provider (the other one is the automatic fallback): gemini or groq
LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=
# Optional second Gemini key (separate quota), tried when the first fails
GOOGLE_API_KEY2=
GEMINI_MODEL=gemini-3.1-flash-lite

# Neon Postgres connection string, e.g. postgresql://user:pass@host/db?sslmode=require
# Leave empty to keep checkpoints in memory (lost on restart).
DATABASE_URL=

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# Observability. LangSmith tracing turns on when the key is set. Traces include prompts, uploaded documents
# and replies, so use it with synthetic data only.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claimwise
# Local JSONL timing log of every graph run (node, model and tool spans); empty disables it.
TRACE_LOG=
