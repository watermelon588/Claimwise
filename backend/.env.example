# Copy to backend/.env and fill in. Never commit .env.

# Primary provider (the other one is the automatic fallback): gemini or groq
LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=
# Optional second Gemini key (separate quota), tried when the first fails
GOOGLE_API_KEY2=
GEMINI_MODEL=gemini-3.1-flash-lite

# Neon Postgres connection string, e.g. postgresql://user:pass@host/db?sslmode=require
# Leave empty to keep checkpoints in memory (lost on restart).
DATABASE_URL=

# JSON list of allowed frontend origins (hosted: add the Vercel URL)
CORS_ORIGINS=["http://localhost:5173"]

# Mock connector gateway (connectors/app.py). Both empty = no connected tools, manual route only.
# CONNECTOR_AGENT_KEY must equal the gateway's CONNECTOR_AGENT_KEY (or the key it prints when that is unset).
CONNECTOR_URL=
CONNECTOR_AGENT_KEY=
# Must equal the mocks' MOCK_WEBHOOK_SECRET; empty disables the signed payer webhook endpoint.
MOCK_WEBHOOK_SECRET=

# Observability. LangSmith tracing turns on when the key is set. Traces include prompts, uploaded documents
# and replies, so use it with synthetic data only.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claimwise
# Local JSONL timing log of every graph run (node, model and tool spans); empty disables it.
TRACE_LOG=
