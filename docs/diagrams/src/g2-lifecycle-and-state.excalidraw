   "locked": false,
   "type": "text",
   "x": 652,
   "y": 1090,
   "width": 576,
   "height": 120.0,
   "text": "New or replaced document, policy choice or claim type: the pack hash\nchanges, so the approval is stale (approval_invalidated), stage = preparing.\nWithdrawn or expired authority: approval cleared, every write blocked.\nCorrecting a policy fact: O2 and C1 recompute everything downstream.\nA second file of the same type: version choice pending (replace or keep)\nblocks the pack until the user answers.\nAfter submission the claim type is fixed (409) and the pack is not resent\n(same hash = 'already submitted').",
   "originalText": "New or replaced document, policy choice or claim type: the pack hash\nchanges, so the approval is stale (approval_invalidated), stage = preparing.\nWithdrawn or expired authority: approval cleared, every write blocked.\nCorrecting a policy fact: O2 and C1 recompute everything downstream.\nA second file of the same type: version choice pending (replace or keep)\nblocks the pack until the user answers.\nAfter submission the claim type is fixed (409) and the pack is not resent\n(same hash = 'already submitted').",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
