   "x": 1540,
   "y": 155,
   "width": 430,
   "height": 16.25,
   "text": "Recovery: accepted but the answer was lost",
   "originalText": "Recovery: accepted but the answer was lost",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
