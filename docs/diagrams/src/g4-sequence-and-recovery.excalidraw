    {
      "id": "mw6ozfbzgl39j3aix77",
      "type": "text",
      "x": 70,
      "y": 1270,
      "width": 550,
      "height": 297.5,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 17,
      "frameId": null,
      "groupIds": [],
      "index": "b0p",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Why it cannot submit twice\n- the key comes from the approved pack,\n  so a retry always sends the same key\n- the payer returns the same claim\n  for that key\n- every unclear failure becomes a\n  lookup, never a blind resend\n\nOther exits\n- consent removed: reconnect\n- bad webhook signature: 401, no change\n- webhook lost: M1 reads on next open\n- a pause survives a browser close or\n  a server restart (checkpoint, V-34)",
      "roughness": 1,
      "roundness": null,
      "seed": 2030910902,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Why it cannot submit twice\n- the key comes from the approved pack,\n  so a retry always sends the same key\n- the payer returns the same claim\n  for that key\n- every unclear failure becomes a\n  lookup, never a blind resend\n\nOther exits\n- consent removed: reconnect\n- bad webhook signature: 401, no change\n- webhook lost: M1 reads on next open\n- a pause survives a browser close or\n  a server restart (checkpoint, V-34)",
      "textAlign": "left",
      "updated": 1794073405548,
      "version": 1,
      "versionNonce": 2137259328,
      "verticalAlign": "top"
    },
