  },
  {
   "id": "e168",
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "seed": 168,
   "version": 1,
   "versionNonce": 168,
   "isDeleted": false,
   "angle": 0,
   "strokeStyle": "solid",
   "groupIds": [],
   "boundElements": [],
   "locked": false,
   "type": "text",
   "x": 1542,
   "y": 600,
   "width": 426,
   "height": 90.0,
   "text": "No worker waits on the insurer: state lives in the\ncheckpoint, M1 reads the claim on open or webhook.\nPauses (O3, approve pack, approve letter) survive a\nbrowser close or a server restart (V-34).\nReminders are dated and deterministic (no duplicates);\nthey resolve when the condition passes.",
   "originalText": "No worker waits on the insurer: state lives in the\ncheckpoint, M1 reads the claim on open or webhook.\nPauses (O3, approve pack, approve letter) survive a\nbrowser close or a server restart (V-34).\nReminders are dated and deterministic (no duplicates);\nthey resolve when the condition passes.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
