  },
  {
   "id": "e165",
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "seed": 165,
   "version": 1,
   "versionNonce": 165,
   "isDeleted": false,
   "angle": 0,
   "strokeStyle": "solid",
   "groupIds": [],
   "boundElements": [],
   "locked": false,
   "type": "text",
   "x": 1542,
   "y": 400,
   "width": 426,
   "height": 135.0,
   "text": "Payer down (5xx, timeout): unconfirmed, reply says so.\nRefused (422 with a reason): shown, no retry.\nConsent removed or session ended (401/403):\n  connection expired; reconnect, then retry.\nWebhook with a bad signature: 401, no state change.\nWebhook lost: the next thread open runs M1 anyway.\nModel down or rate-limited: Groq fallback; a failed\n  parse leaves the document 'failed', upload again.\nText inside letters is data, never instructions (J7).",
   "originalText": "Payer down (5xx, timeout): unconfirmed, reply says so.\nRefused (422 with a reason): shown, no retry.\nConsent removed or session ended (401/403):\n  connection expired; reconnect, then retry.\nWebhook with a bad signature: 401, no state change.\nWebhook lost: the next thread open runs M1 anyway.\nModel down or rate-limited: Groq fallback; a failed\n  parse leaves the document 'failed', upload again.\nText inside letters is data, never instructions (J7).",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "e166",
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
