  },
  {
   "id": "e104",
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "seed": 104,
   "version": 1,
   "versionNonce": 104,
   "isDeleted": false,
   "angle": 0,
   "strokeStyle": "solid",
   "groupIds": [],
   "boundElements": [],
   "locked": false,
   "type": "text",
   "x": 30,
   "y": 1110,
   "width": 1800,
   "height": 16.25,
   "text": "Context classes: who it belongs to and how far it travels",
   "originalText": "Context classes: who it belongs to and how far it travels",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "e105",
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "seed": 105,
   "version": 1,
   "versionNonce": 105,
   "isDeleted": false,
   "angle": 0,
   "strokeStyle": "solid",
   "groupIds": [],
   "boundElements": [],
   "locked": false,
   "type": "text",
   "x": 32,
   "y": 1135,
   "width": 1796,
   "height": 90.0,
   "text": "Personal (one person, in this claim's thread): the patient's medical documents (discharge summary, bills, lab reports), the bank statement, messages; the caregiver's proof of authority.\nHousehold or shared: policy facts that cover several members (family floater, employer cover), the authority the patient grants a caregiver, the choice of which policy to claim first.\n  Built: held in each claim's thread. Proposed: a household profile shared by the family's claims.\nTask-specific (this claim only): claim type, pack and approval hashes, submission and client reference, queries, decision, payment, dispute, reminders, audit.\nReusable across cycles: rule tables in code (TATs, required documents, Ombudsman limits) and the extraction schema. Proposed, not built: reuse confirmed policy facts\n  and an unexpired authority for the next claim. Today each claim starts a new thread and nothing is carried over automatically.",
   "originalText": "Personal (one person, in this claim's thread): the patient's medical documents (discharge summary, bills, lab reports), the bank statement, messages; the caregiver's proof of authority.\nHousehold or shared: policy facts that cover several members (family floater, employer cover), the authority the patient grants a caregiver, the choice of which policy to claim first.\n  Built: held in each claim's thread. Proposed: a household profile shared by the family's claims.\nTask-specific (this claim only): claim type, pack and approval hashes, submission and client reference, queries, decision, payment, dispute, reminders, audit.\nReusable across cycles: rule tables in code (TATs, required documents, Ombudsman limits) and the extraction schema. Proposed, not built: reuse confirmed policy facts\n  and an unexpired authority for the next claim. Today each claim starts a new thread and nothing is carried over automatically.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
 ],
