   "x": 1250,
   "y": 835,
   "width": 580,
   "height": 16.25,
   "text": "Retention and deletion (prototype status)",
   "originalText": "Retention and deletion (prototype status)",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "e102",
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "seed": 102,
   "version": 1,
   "versionNonce": 102,
   "isDeleted": false,
   "angle": 0,
   "strokeStyle": "solid",
   "groupIds": [],
   "boundElements": [],
   "locked": false,
   "type": "text",
   "x": 1252,
   "y": 860,
   "width": 576,
   "height": 180.0,
   "text": "Built: rejected uploads are deleted at once; superseded and\n  archived documents are kept as claim evidence.\nBuilt: the thread list only returns ids the browser already\n  holds; the server never lists every claim.\nBuilt: the user can delete one document (purged from current\n  and earlier checkpoints, file removed) or a whole session.\nNot built (TBD before real users): user login and tenancy, a\n  retention period, export of a user's data.\nLangSmith receives prompts and outputs: keep it to synthetic\n  data, or turn tracing off, until a privacy review approves it.\nSecrets (model keys, LangSmith key, connector key, webhook\n  secret) live in backend/.env, never in state or logs.",
   "originalText": "Built: rejected uploads are deleted at once; superseded and\n  archived documents are kept as claim evidence.\nBuilt: the thread list only returns ids the browser already\n  holds; the server never lists every claim.\nBuilt: the user can delete one document (purged from current\n  and earlier checkpoints, file removed) or a whole session.\nNot built (TBD before real users): user login and tenancy, a\n  retention period, export of a user's data.\nLangSmith receives prompts and outputs: keep it to synthetic\n  data, or turn tracing off, until a privacy review approves it.\nSecrets (model keys, LangSmith key, connector key, webhook\n  secret) live in backend/.env, never in state or logs.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "e103",
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
