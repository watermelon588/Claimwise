   "locked": false,
   "id": "t210",
   "type": "text",
   "x": 42,
   "y": 612,
   "width": 500,
   "height": 178.75,
   "text": "STATE (saved per thread_id)\nmessages; documents [{id, doc_type, status, facts, source}]\npolicies; user_role; onboarding {complete, missing}\nclaim_info {claim_type, submitted_on, claim_number}\nsubmission_approval {hash, approved_at}  (stale if pack changes)\nconnection {case_id, status}  (case id never leaves the server)\nsubmission {route, status, claim_id, client_reference, last_checked}\nnotifications [{id, kind, text, read}]; requested_action; intent\nclaim (C1) + claim.payment (P1)\nv0.7: authority {basis, proof, scope, expiry, status}; audit [...]\nv0.7: dispute {...}; claims_history; claim_info.policy_doc_id, round, balance_of",
   "originalText": "STATE (saved per thread_id)\nmessages; documents [{id, doc_type, status, facts, source}]\npolicies; user_role; onboarding {complete, missing}\nclaim_info {claim_type, submitted_on, claim_number}\nsubmission_approval {hash, approved_at}  (stale if pack changes)\nconnection {case_id, status}  (case id never leaves the server)\nsubmission {route, status, claim_id, client_reference, last_checked}\nnotifications [{id, kind, text, read}]; requested_action; intent\nclaim (C1) + claim.payment (P1)\nv0.7: authority {basis, proof, scope, expiry, status}; audit [...]\nv0.7: dispute {...}; claims_history; claim_info.policy_doc_id, round, balance_of",
   "fontSize": 13,
