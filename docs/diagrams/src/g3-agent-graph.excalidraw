   "id": "t201",
   "type": "text",
   "x": 40,
   "y": 8,
   "width": 1400,
   "height": 25.0,
   "text": "G3 Agent graph v0.7 (BUILT 2026-11-05). Wave 4: document versions, household policies and balance claims, caregiver authority, grievance and Ombudsman.",
   "originalText": "G3 Agent graph v0.7 (BUILT 2026-11-05). Wave 4: document versions, household policies and balance claims, caregiver authority, grievance and Ombudsman.",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "seed": 205,
   "version": 1,
   "versionNonce": 206,
   "isDeleted": false,
   "angle": 0,
   "strokeStyle": "solid",
   "groupIds": [],
   "boundElements": [],
   "locked": false,
   "id": "t204",
   "type": "text",
   "x": 40,
   "y": 36,
   "width": 1400,
   "height": 17.5,
   "text": "Every turn: START -> M1 -> O1 -> O2 -> C1 -> (P1) -> turn route. Button -> X1 -> C1 -> END. Typed text -> I1 -> A1 or R1. Uploads and tool results -> A1.",
   "originalText": "Every turn: START -> M1 -> O1 -> O2 -> C1 -> (P1) -> turn route. Button -> X1 -> C1 -> END. Typed text -> I1 -> A1 or R1. Uploads and tool results -> A1.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "roughness": 0,
   "opacity": 100,
   "seed": 208,
   "version": 1,
   "versionNonce": 209,
   "isDeleted": false,
   "angle": 0,
   "strokeStyle": "solid",
   "groupIds": [],
   "boundElements": [],
   "locked": false,
   "id": "t207",
   "type": "text",
   "x": 40,
   "y": 58,
   "width": 1400,
   "height": 17.5,
   "text": "Colours: blue = model, grey = deterministic Python, teal = new this step, orange = human pause, green = tools, yellow = API and external. Dashed = run ends.",
   "originalText": "Colours: blue = model, grey = deterministic Python, teal = new this step, orange = human pause, green = tools, yellow = API and external. Dashed = run ends.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
